---
import Article from '../../layouts/Article.astro';
import { posts } from '../../lib/posts';
export async function getStaticPaths(){ return (await posts()).filter(p=>p.data.type==='writeup' && !p.data.externalUrl).map(post=>({params:{slug:post.id},props:{post}})); }
const { post } = Astro.props;
---
<Article post={post}/>
